# Checkout links for each pricing tier (Stripe Payment Links, Lemon Squeezy, Paddle, Gumroad, Podia or similar).
# Leave a link empty and that tier's button opens an email to ask about it instead.
PUBLIC_CHECKOUT_URL_SELF_PACED=
PUBLIC_CHECKOUT_URL_WORKBOOK=
PUBLIC_CHECKOUT_URL_WITH_REVIEWS=

# Where the questions and waitlist form sends its entries (Formspree, Basin, a Supabase function or similar).
# Leave empty and the form falls back to opening the visitor's email app.
PUBLIC_FORM_ENDPOINT=

# Your site's public address, used for the sitemap, canonical links and social previews.
SITE_URL=https://example.com
