---
import Base from "../layouts/Base.astro";
import Ledger from "../components/Ledger.astro";
import Modules from "../components/Modules.astro";
import Pricing from "../components/Pricing.astro";
import QuestionForm from "../components/QuestionForm.astro";
import { course, forWho, outcomes, instructor, results, quotes, resultsNote, faq, tiers } from "../data/site";
import { lessonCount, totalMinutes, duration, usd } from "../lib/course";

const from = Math.min(...tiers.map((t) => t.price));
---

<Base>
  <section class="hero wrap">
    <div class="copy">
      <h1 class="h1">{course.headline}</h1>
      <p class="lede">{course.intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#pricing">Enroll from {usd(from)}</a>
        <a class="btn btn-quiet" href="/lessons/sample">Watch a free lesson</a>
      </div>
      <dl class="facts">
        <div><dt>Lessons</dt><dd class="mono">{lessonCount}</dd></div>
        <div><dt>Video</dt><dd class="mono">{duration(totalMinutes)}</dd></div>
        <div><dt>Access</dt><dd>{course.access}</dd></div>
      </dl>
    </div>
    <Ledger />
  </section>

  <section class="section wrap who" aria-labelledby="who-title">
    <h2 id="who-title" class="h2">Who it's for</h2>
    <div class="lists">
      <div>
        <h3>A good fit if you're</h3>
        <ul class="yes">{forWho.yes.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h3>Not the right course for</h3>
        <ul class="no">{forWho.no.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section outcomes-band" aria-labelledby="outcomes-title">
    <div class="wrap">
      <h2 id="outcomes-title" class="h2">By the end of the course</h2>
      <ul class="outcomes">
        {
          outcomes.map((o) => (
            <li>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="curriculum" class="section wrap" aria-labelledby="curr-title">
    <div class="head-row">
      <div class="section-head">
        <h2 id="curr-title" class="h2">Curriculum</h2>
        <p class="lede">Six modules, short lessons, and an exercise in your own spreadsheet at the end of each one.</p>
      </div>
      <a class="text-link" href="/curriculum">Every lesson on one page</a>
    </div>
    <Modules />
  </section>

  <section id="instructor" class="section wrap instructor" aria-labelledby="inst-title">
    <div class="portrait" aria-hidden="true">
      <span class="initials">DW</span>
    </div>
    <div class="bio">
      <p class="muted role">Your instructor</p>
      <h2 id="inst-title" class="h2">{instructor.name}</h2>
      <p class="role2">{instructor.role}</p>
      {instructor.bio.map((p) => <p>{p}</p>)}
      <p class="small muted">{instructor.note}</p>
    </div>
  </section>

  <section class="section results-band" aria-labelledby="results-title">
    <div class="wrap">
      <h2 id="results-title" class="h2">What students say</h2>
      <dl class="stats">
        {
          results.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd class="mono">{r.figure}</dd>
              <dd class="src muted">{r.note}</dd>
            </div>
          ))
        }
      </dl>
      <div class="quotes">
        {
          quotes.map((q, i) => (
            <figure class:list={{ lead: i === 0 }}>
              <blockquote>{q.text}</blockquote>
              <figcaption>
                {q.name} <span class="muted">{q.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="small muted sample">{resultsNote}</p>
    </div>
  </section>

  <section id="pricing" class="section wrap" aria-labelledby="pricing-title">
    <div class="section-head">
      <h2 id="pricing-title" class="h2">Pricing</h2>
      <p class="lede">One payment, lifetime access. Pick the amount of help you'd like.</p>
    </div>
    <Pricing />
  </section>

  <section id="faq" class="section wrap faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="h2">Questions</h2>
    <div>
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section final" aria-labelledby="final-title">
    <div class="wrap final-grid">
      <div>
        <h2 id="final-title" class="h2">Start with next month</h2>
        <p class="lede">Module 1 takes about an hour, and by the end of it your first month is in the ledger. Enroll now, or send Dana a question first.</p>
        <a class="btn btn-primary" href="#pricing">Enroll from {usd(from)}</a>
      </div>
      <QuestionForm />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 6vw, 80px);
  }
  .copy {
    display: grid;
    gap: 24px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .facts {
    display: flex;
    gap: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line-strong);
  }
  .facts dt {
    font-size: 13px;
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
    font-size: 15px;
  }
  .who {
    border-top: 1px solid var(--line);
  }
  .lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 32px;
  }
  h3 {
    font-size: 17px;
    font-weight: 500;
  }
  .lists ul {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .lists li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    color: var(--ink-2);
  }
  .yes li::before,
  .no li::before {
    content: "";
    margin-top: 12px;
    width: 12px;
    height: 1.5px;
    background: var(--accent);
  }
  .no li::before {
    background: var(--ink-3);
  }
  .outcomes-band {
    background: var(--card);
    border-block: 1px solid var(--line);
  }
  .outcomes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 48px;
    margin-top: 40px;
  }
  .outcomes li {
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .outcomes p {
    color: var(--ink-2);
    margin-top: 4px;
  }
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .instructor {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
    border-top: 1px solid var(--line);
  }
  .portrait {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background: var(--raised);
    display: grid;
    place-items: center;
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, var(--rule) 31px 32px);
  }
  .initials {
    font-family: var(--mono);
    font-size: 40px;
    color: var(--ink-3);
  }
  .bio {
    display: grid;
    gap: 14px;
    max-width: 40rem;
  }
  .role {
    font-size: 14px;
  }
  .role2 {
    color: var(--accent);
    margin-top: -6px;
  }
  .small {
    font-size: 14px;
  }
  .results-band {
    background: var(--ink);
    color: #eef0ea;
  }
  .results-band .muted {
    color: #a7b0aa;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .stats dt {
    font-size: 15px;
    color: #c8cfc9;
    order: 2;
  }
  .stats div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stats dd {
    margin: 0;
  }
  .stats dd.mono {
    font-size: 32px;
    order: 1;
  }
  .stats .src {
    font-size: 13px;
    order: 3;
  }
  .quotes {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 32px;
    margin-top: 40px;
  }
  blockquote {
    font-size: 17px;
    line-height: 1.55;
  }
  .lead blockquote {
    font-size: 22px;
    line-height: 1.4;
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
  }
  .sample {
    margin-top: 32px;
  }
  .faq {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  details summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::after {
    content: "+";
    font-family: var(--mono);
    color: var(--ink-3);
    font-weight: 400;
  }
  details[open] summary::after {
    content: "-";
  }
  details p {
    padding-bottom: 18px;
    color: var(--ink-2);
    max-width: 40rem;
  }
  .final {
    background: var(--card);
    border-top: 1px solid var(--line);
  }
  .final-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .final-grid > div {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .lists,
    .instructor,
    .faq,
    .final-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: 200px;
    }
    .quotes,
    .stats {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .outcomes {
      grid-template-columns: 1fr;
    }
  }
</style>
