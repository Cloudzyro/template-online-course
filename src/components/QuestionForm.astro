---
// Sends to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a Supabase function or similar).
// With no endpoint set, sending opens the visitor's email app instead.
import { course } from "../data/site";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const subject = `Question about ${course.name}`;
---

<form class="question" method="post" action={endpoint || `mailto:${course.email}`} data-endpoint={endpoint} data-email={course.email} data-subject={subject}>
  {
    !endpoint && (
      <p class="note" role="note">
        This form isn't connected yet, so sending it opens your email app. You can also write to{" "}
        <a href={`mailto:${course.email}?subject=${encodeURIComponent(subject)}`}>{course.email}</a>.
      </p>
    )
  }
  <input type="hidden" name="_subject" value={subject} />
  <div class="row">
    <label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label>
    <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
  </div>
  <label class="field">
    <span>Your question</span>
    <textarea name="question" rows="4"></textarea>
  </label>
  <label class="check">
    <input type="checkbox" name="waitlist" value="yes" />
    <span>Email me when lessons are added or updated</span>
  </label>
  <div class="actions">
    <button class="btn btn-quiet" type="submit">Send question</button>
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form.question").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".status")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { endpoint, email, subject } = form.dataset;
      const data = new FormData(form);
      if (!endpoint) {
        const lines: string[] = [];
        for (const [key, value] of data.entries()) {
          if (key.startsWith("_") || !String(value).trim()) continue;
          lines.push(`${key}: ${value}`);
        }
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
        status.textContent = "Your email app should open with your question filled in.";
        return;
      }
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "Sending";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "Thanks. Dana answers questions within two working days.";
      } catch {
        status.textContent = "";
        status.append("Sorry, that didn't send. Please email ");
        const link = Object.assign(document.createElement("a"), { href: `mailto:${email}`, textContent: email });
        status.append(link, ".");
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .question {
    display: grid;
    gap: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .note {
    font-size: 14px;
    color: var(--ink-2);
    background: var(--raised);
    border-radius: var(--radius);
    padding: 12px 16px;
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 15px;
    cursor: pointer;
  }
  .check input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--accent);
  }
  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .status {
    font-size: 15px;
    color: var(--ink-2);
  }
</style>
