---
// Curriculum as disclosure lists: each module opens to its lessons and their lengths.
import { modules } from "../data/site";
import { duration, moduleMinutes } from "../lib/course";

interface Props {
  open?: "first" | "all" | "none";
}
const { open = "first" } = Astro.props;
---

<ol class="modules">
  {
    modules.map((m, i) => (
      <li>
        <details open={open === "all" || (open === "first" && i === 0)}>
          <summary>
            <span class="no mono">Module {i + 1}</span>
            <span class="title">{m.title}</span>
            <span class="meta mono muted">
              {m.lessons.length} lessons, {duration(moduleMinutes(i))}
            </span>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <div class="body">
            <p class="summary">{m.summary}</p>
            <ol class="lessons">
              {m.lessons.map((l, j) => (
                <li>
                  <span class="n mono muted">
                    {i + 1}.{j + 1}
                  </span>
                  <span class="lt">
                    {l.title}
                    {l.free && (
                      <a class="free" href="/lessons/sample">
                        Watch free
                      </a>
                    )}
                  </span>
                  <span class="mono muted len">{l.minutes} min</span>
                </li>
              ))}
            </ol>
          </div>
        </details>
      </li>
    ))
  }
</ol>

<style>
  .modules {
    border-top: 1px solid var(--line-strong);
  }
  .modules > li {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) auto 18px;
    gap: 16px;
    align-items: center;
    padding-block: 20px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .no {
    font-size: 12px;
    color: var(--accent);
  }
  .title {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .meta {
    font-size: 12px;
  }
  .chev {
    color: var(--ink-3);
    transition: transform 200ms var(--ease);
  }
  details[open] .chev {
    transform: rotate(180deg);
  }
  summary:hover .title {
    color: var(--accent);
  }
  .body {
    padding: 0 0 24px 120px;
  }
  .summary {
    color: var(--ink-2);
    max-width: 40rem;
    margin-bottom: 12px;
  }
  .lessons li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding-block: 8px;
    border-top: 1px solid var(--rule);
    font-size: 16px;
  }
  .n,
  .len {
    font-size: 12px;
  }
  .free {
    margin-left: 10px;
    font-size: 14px;
    color: var(--accent);
    text-underline-offset: 3px;
  }
  @media (max-width: 700px) {
    summary {
      grid-template-columns: minmax(0, 1fr) 18px;
      gap: 4px 12px;
    }
    .no {
      grid-column: 1;
    }
    .title {
      grid-column: 1;
      font-size: 18px;
    }
    .meta {
      grid-column: 1;
    }
    .chev {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
    .body {
      padding-left: 0;
    }
  }
</style>
