---
// Pricing tiers. Each button goes to that tier's checkout link (see src/lib/course.ts);
// a tier with no link opens an email to ask about it instead.
import { tiers, course } from "../data/site";
import { checkoutFor, usd } from "../lib/course";

const anyMissing = tiers.some((t) => !checkoutFor(t.id).ready);
---

<div class="tiers">
  {
    tiers.map((t) => {
      const c = checkoutFor(t.id);
      return (
        <article class:list={["tier", { featured: t.featured }]} aria-labelledby={`tier-${t.id}`}>
          <h3 id={`tier-${t.id}`}>{t.name}</h3>
          <p class="price mono">
            <span class="total">{usd(t.price)}</span>
            <span class="once muted">one payment</span>
          </p>
          <p class="summary">{t.summary}</p>
          <ul>
            {t.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <a class:list={["btn", t.featured ? "btn-primary" : "btn-quiet"]} href={c.href} rel={c.ready ? "noopener" : undefined}>
            {c.ready ? `Enroll, ${usd(t.price)}` : "Ask about this option"}
          </a>
        </article>
      );
    })
  }
</div>
<p class="guarantee">{course.guarantee}</p>
{
  anyMissing && (
    <p class="note muted">
      Checkout isn't connected yet for every option, so those buttons open an email instead. Set the checkout links to take payments.
    </p>
  )
}

<style>
  .tiers {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 16px;
    align-items: stretch;
  }
  .tier {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 16px;
    padding: 28px 24px 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .featured {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgb(27 34 30 / 0.07);
  }
  h3 {
    font-size: 18px;
    font-weight: 500;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 32px;
    line-height: 1.2;
  }
  .once {
    font-family: var(--font);
    font-size: 14px;
  }
  .summary {
    color: var(--ink-2);
    font-size: 16px;
  }
  ul {
    display: grid;
    gap: 8px;
    align-content: start;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
  }
  li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
  }
  li::before {
    content: "";
    width: 10px;
    height: 1.5px;
    margin-top: 11px;
    background: var(--accent);
  }
  .btn {
    width: 100%;
  }
  .guarantee {
    margin-top: 24px;
    font-size: 16px;
  }
  .note {
    margin-top: 8px;
    font-size: 13px;
  }
  @media (max-width: 900px) {
    .tiers {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }
</style>
